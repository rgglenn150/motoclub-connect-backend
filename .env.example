# Example environment for motoclub-connect-backend.
# Copy to .env and fill in real values. Never commit .env.
# Only the share-link-preview settings (spec 001) are listed here so far;
# other variables (MONGO_*, JWT_SECRET, CLOUDINARY_*, ...) are not listed yet.

# Public URL of the app (PWA). Share links redirect here. Defaults to the first FRONTEND_URL entry.
PUBLIC_APP_URL=https://app.example.com

# Public URL of this API, used for absolute og:image URLs on /share pages.
# Defaults to the request's protocol + host (Express trusts one proxy hop, see ADR-0001).
PUBLIC_API_URL=https://api.example.com

# Max requests per minute per client IP on /share/* (ADR-0001). Default 120.
SHARE_RATE_LIMIT_PER_MIN=120

# Shared secret between the app's Vercel middleware and this API (ADR-0002).
# When a /share request carries it, the rate limit keys on X-Share-Client-IP.
# Random, at least 32 chars (openssl rand -hex 32). Set the same value in the
# Vercel project env. Never commit the real value.
SHARE_PROXY_SECRET=
